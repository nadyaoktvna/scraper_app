<div id="scraper_controls">
  <%= render "books/scraper_notifications", last_result: local_assigns[:last_result] %>
  <%= render "books/scraper_action_area" %>
</div>

<script>
  // Event Delegation agar logic show/hide URL input tetap berjalan
  document.addEventListener('change', function(e) {
    if (e.target && e.target.id === 'mode-select') {
      const container = document.getElementById('url-input-container');
      container.style.display = (e.target.value === 'url') ? 'block' : 'none';
    }
  });

  document.addEventListener('click', function(e) {
    const closeBtn = e.target.closest('#scraper_notifications .btn-close');
    if (!closeBtn) return;

    const url = closeBtn.dataset.dismissUrl;
    if (!url) return;

    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

    fetch(url, {
      method: 'DELETE',
      headers: csrfToken ? { 'X-CSRF-Token': csrfToken } : {}
    }).catch(function(err) {
      console.warn('Gagal memberi tahu server soal dismiss notifikasi:', err);
    });
  });
</script>
