<div id="scraper_action_area">
  <% if ScraperTool.running? %>
    <div class="alert alert-info d-flex align-items-center mb-0">
      <div class="spinner-border spinner-border-sm me-3"></div>
      <div>Scraping sedang berjalan...</div>
    </div>
    <div class="mt-3">
      <%= button_to stop_scrape_books_path, method: :delete, class: "btn btn-danger w-100" do %>
        <i class="bi bi-stop-circle"></i> STOP
      <% end %>
    </div>
  <% else %>
    <%= form_with url: scrape_books_path, method: :post, class: "row g-3 align-items-end" do |f| %>
      <div class="col-md-3">
        <%= f.label :scrape_mode, "Mode:", class: "form-label" %>
        <%= f.select :scrape_mode, 
            [['All Pages', 'all'], ['First Page', 'single'], ['URL (Specific)', 'url']], 
            {}, 
            { class: "form-select", id: "mode-select" } 
        %>
      </div>
      
      <%# Menambahkan wrapper agar tampilan lebih konsisten saat muncul/hilang %>
      <div class="col-md-6" id="url-input-container" style="display: none;">
        <%= f.label :custom_url, "Target URL:", class: "form-label" %>
        <%= f.text_field :custom_url, 
            class: "form-control", 
            placeholder: "https://books.toscrape.com/..." 
        %>
      </div>
      
      <div class="col-md-auto">
        <%= f.button type: "submit", class: "btn btn-primary px-4" do %>
          <i class="bi bi-play-fill"></i> Start
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
