<div id="scraper_action_area">
  <% if ScraperTool.running? %>
    <div class="alert alert-info d-flex align-items-center mb-3">
      <div class="spinner-border spinner-border-sm me-3" role="status"></div>
      <div>
        <strong>Scraper in progress...</strong> Fetching book details and updating catalog in real-time.
      </div>
    </div>
    <div>
      <%= button_to stop_scrape_books_path, method: :delete, class: "btn btn-danger w-100" do %>
        <i class="bi bi-stop-circle me-1"></i> Stop Scraping Process
      <% end %>
    </div>
  <% else %>
    <%= form_with url: scrape_books_path, method: :post, class: "row g-3 align-items-end" do |f| %>
      <div class="col-md-4">
        <%= f.label :scrape_mode, "Mode:", class: "form-label fw-semibold" %>
        <%= f.select :scrape_mode,
             [['All Pages', 'all'], ['First Page Only', 'single'], ['Custom URL', 'url']],
             {},
             { class: "form-select", id: "mode-select" } 
        %>
      </div>

      <div class="col-md-5" id="url-input-container" style="display: none;">
        <%= f.label :custom_url, "Target URL:", class: "form-label fw-semibold" %>
        <%= f.text_field :custom_url,
             class: "form-control",
             placeholder: "https://books.toscrape.com/..."
        %>
      </div>

      <div class="col-md-auto ms-auto">
        <%= f.button type: "submit", class: "btn btn-primary px-4 w-100" do %>
          <i class="bi bi-play-fill me-1"></i> Start Scraping
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
