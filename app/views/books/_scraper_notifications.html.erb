<div id="scraper_notifications">
  <% if local_assigns[:last_result].present? %>
    <% last_result = local_assigns[:last_result] %>
    <% status_class = case last_result[:status]
                      when :success then 'success'
                      when :stopped then 'warning'
                      else 'danger'
                      end %>
    
    <div class="alert alert-<%= status_class %> alert-dismissible fade show mb-3 shadow-sm border-0" role="alert">
      <div class="d-flex align-items-center">
        <i class="bi <%= status_class == 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill' %> me-2 fs-5"></i>
        <div>
          <strong><%= last_result[:status].to_s.upcase %>:</strong> <%= last_result[:message] %>
        </div>
      </div>
      <button type="button" 
              class="btn-close" 
              data-bs-dismiss="alert" 
              aria-label="Close"
              data-dismiss-url="<%= dismiss_notification_books_path %>"></button>
    </div>
  <% end %>
</div>
