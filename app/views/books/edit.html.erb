<div class="container mt-5">
  <div class="card shadow-sm border-0 p-4 col-md-6 mx-auto">
    <h2 class="mb-4">Edit Buku</h2>
    
    <%= form_with model: @book, local: true do |f| %>
      <div class="mb-3">
        <%= f.label :title, class: "form-label" %>
        <%= f.text_field :title, class: "form-control" %>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= f.label :price, "Price (£)", class: "form-label" %>
          <%= f.number_field :price, step: 0.01, class: "form-control" %>
        </div>
        <div class="col-md-6 mb-3">
          <%= f.label :availability, "Stock", class: "form-label" %>
          <%= f.number_field :availability, class: "form-control" %>
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :cover_image, "Cover Image", class: "form-label" %>
        <%= f.file_field :cover_image, class: "form-control" %>
      </div>

      <div class="d-grid gap-2">
        <%= f.submit "Simpan Perubahan", class: "btn btn-primary" %>
        <%= link_to "Kembali", books_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
