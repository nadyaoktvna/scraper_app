<div class="container my-5">
  <div class="card shadow-sm border-0 p-4 col-md-6 mx-auto">
    <h2 class="mb-4 fw-bold">Edit Book</h2>
    
    <%= form_with model: @book, local: true do |f| %>
      <div class="mb-3">
        <%= f.label :title, "Book Title", class: "form-label fw-semibold" %>
        <%= f.text_field :title, class: "form-control" %>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= f.label :price, "Price (£)", class: "form-label fw-semibold" %>
          <%= f.number_field :price, step: 0.01, class: "form-control" %>
        </div>
        <div class="col-md-6 mb-3">
          <%= f.label :availability, "Stock Availability", class: "form-label fw-semibold" %>
          <%= f.number_field :availability, class: "form-control" %>
        </div>
      </div>

      <div class="mb-4">
        <%= f.label :cover_image, "Cover Image File", class: "form-label fw-semibold" %>
        <%= f.file_field :cover_image, class: "form-control" %>
      </div>

      <div class="d-grid gap-2">
        <%= f.submit "Save Changes", class: "btn btn-primary" %>
        <%= link_to "Cancel", books_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>
