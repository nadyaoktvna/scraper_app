<div id="books_grid">
  <% if books.any? %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
      <% books.each do |book| %>
        <div class="col">
          <div class="card h-100 shadow-sm border-0 position-relative <%= 'opacity-75' if book.availability <= 0 %>">
            
            <!-- Image Container with Fixed Aspect Ratio -->
            <div class="ratio ratio-4x3 bg-light rounded-top overflow-hidden">
              <%= book_cover_tag(book) %>
            </div>

            <div class="card-body d-flex flex-column">
              <!-- Category & Star Rating -->
              <div class="d-flex justify-content-between align-items-center mb-1">
                <small class="text-muted text-uppercase fw-bold fs-7"><%= book.category.presence || 'General' %></small>
                <div class="text-warning small" title="Rating: <%= book.rating %> / 5">
                  <% (1..5).each do |i| %>
                    <i class="bi <%= i <= (book.rating || 0) ? 'bi-star-fill' : 'bi-star' %>"></i>
                  <% end %>
                </div>
              </div>

              <!-- Book Title -->
              <h6 class="card-title text-truncate fw-semibold mb-2" title="<%= book.title %>">
                <%= book.title %>
              </h6>

              <!-- Price & Stock Badge -->
              <div class="mt-auto d-flex justify-content-between align-items-center pt-2">
                <span class="fs-5 fw-bold text-primary"><%= number_to_currency(book.price, unit: "£") %></span>
                <span class="badge <%= book.availability > 0 ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-secondary-subtle text-secondary' %>">
                  <%= book.availability > 0 ? "Stock: #{book.availability}" : 'Out of Stock' %>
                </span>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="card-footer bg-transparent border-0 pt-0 pb-3">
              <div class="d-flex gap-2 mb-2">
                <% if book.availability > 0 %>
                  <%= button_to purchase_book_path(book), method: :post, class: "btn btn-sm btn-primary w-100 rounded-pill" do %>
                    <i class="bi bi-cart-plus me-1"></i> Buy Now
                  <% end %>
                <% else %>
                  <button class="btn btn-sm btn-secondary w-100 rounded-pill" disabled>Sold Out</button>
                <% end %>
              </div>

              <!-- Admin Controls (Edit / Delete) -->
              <div class="d-flex justify-content-end align-items-center gap-1 border-top pt-2">
                <small class="text-muted me-auto fs-7">ID: <%= book.id %></small>
                <%= link_to edit_book_path(book), class: "btn btn-xs btn-outline-secondary border-0 p-1", title: "Edit Book" do %>
                  <i class="bi bi-pencil"></i>
                <% end %>
                <%= button_to book_path(book), method: :delete, class: "btn btn-xs btn-outline-danger border-0 p-1", title: "Delete Book" do %>
                  <i class="bi bi-trash"></i>
                <% end %>
              </div>
            </div>

          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-5 my-5">
      <div class="display-1 text-muted mb-3"><i class="bi bi-journal-x"></i></div>
      <h3 class="text-secondary fw-bold">No books available</h3>
      <p class="text-muted">It seems the library is empty. Please trigger the scraper to fetch the latest books.</p>
    </div>
  <% end %>
</div>
